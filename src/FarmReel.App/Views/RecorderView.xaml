<UserControl x:Class="FarmReel.App.Views.RecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Device:" VerticalAlignment="Center"/>
            <ComboBox x:Name="DeviceCombo" ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDevice, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            <Button Content="Start Recording" Click="Start_Click" FontWeight="Bold"/>
            <Button Content="Stop" Click="Stop_Click"/>
            <Button Content="Save" Click="Save_Click"/>
            <Button Content="Clear" Click="Clear_Click"/>
            <TextBlock Text="Flow name:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="NameBox" Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="How it works: press Start, then operate the emulator manually. Screen changes are auto-recorded as waitFor steps. Click anywhere on the live preview to record a tap at that spot. Save -> the flow appears in the Flows tab and is used instead of the built-in one." TextWrapping="Wrap" Margin="4,4,4,6" Foreground="Gray"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#CCC" BorderThickness="1" Margin="4">
                <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" MaxHeight="560"
                       MouseLeftButtonDown="Preview_MouseDown" SnapsToDevicePixels="True"/>
            </Border>
            <ListBox Grid.Column="1" x:Name="StepList" ItemsSource="{Binding Steps}" Margin="4,0,0,0"/>
        </Grid>
    </DockPanel>
</UserControl>

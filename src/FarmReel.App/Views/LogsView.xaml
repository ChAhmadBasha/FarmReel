<UserControl x:Class="FarmReel.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Width="200" TextChanged="Filter_Changed"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Entries}" SelectionMode="Single"/>
    </DockPanel>
</UserControl>
